{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/regular-257/final-pair-line-chord-search.schema.json",
  "title": "Euclid-Min regular-257 final-pair line chord search v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "semantics", "universe", "search"],
  "properties": {
    "schema": {
      "const": "euclid-min-regular-257-final-pair-line-chord-search/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate",
        "certificate_sha256",
        "full_intersection_closure_report",
        "full_intersection_closure_report_sha256",
        "candidate_frontier_report",
        "candidate_frontier_report_sha256"
      ],
      "properties": {
        "certificate": { "const": "construction-69e.json" },
        "certificate_sha256": { "$ref": "#/$defs/sha256" },
        "full_intersection_closure_report": {
          "const": "full-intersection-closure-69e.json"
        },
        "full_intersection_closure_report_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_frontier_report": {
          "const": "full-point-candidate-frontier-69e.json"
        },
        "candidate_frontier_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed_paid_drawables",
        "selected_paid_drawables",
        "candidate_e_move",
        "candidate_family",
        "target_event",
        "limitations"
      ],
      "properties": {
        "removed_paid_drawables": { "const": ["BG0", "target_transfer"] },
        "selected_paid_drawables": { "const": 67 },
        "candidate_e_move": { "const": 68 },
        "candidate_family": {
          "const": "one_line_through_two_available_materialized_exact_points"
        },
        "target_event": {
          "const": "the_two_new_intersections_of_candidate_line_and_c0_are_adjacent"
        },
        "limitations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_points",
        "available_exact_coordinate_points",
        "line_definitions"
      ],
      "properties": {
        "available_points": { "const": 2103 },
        "available_exact_coordinate_points": { "const": 1759 },
        "line_definitions": { "const": 1546161 }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitions_tested",
        "ball_excluded_definitions",
        "exact_checks",
        "solutions",
        "solutions_found",
        "status"
      ],
      "properties": {
        "definitions_tested": { "const": 1546161 },
        "ball_excluded_definitions": { "const": 1546161 },
        "exact_checks": { "const": 0 },
        "solutions": { "type": "array", "maxItems": 0 },
        "solutions_found": { "const": 0 },
        "status": { "const": "exhausted_no_solution" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

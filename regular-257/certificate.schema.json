{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/regular-257/certificate.schema.json",
  "title": "Euclid-Min regular-257 construction certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem",
    "profile",
    "source",
    "construction",
    "assertions",
    "software",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "euclid-min-regular-257-certificate/v1" },
    "problem": { "const": "regular-257-free-edge" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "regular-257-free-edge-e-fixed-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "steps_table"],
      "properties": {
        "kind": { "const": "public_video_transcription" },
        "url": { "type": "string", "format": "uri" },
        "steps_table": { "const": "video-69e-steps.csv" }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "program"],
      "properties": {
        "id": { "const": "video-69e-transcription" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "program": {
          "type": "array",
          "minItems": 69,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/lineEntry" },
              { "$ref": "#/$defs/circleEntry" },
              { "$ref": "#/$defs/intersectEntry" }
            ]
          }
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "draws",
        "target_witnesses",
        "first_bound_target_e_move",
        "automatic_closure_first_hit",
        "claim"
      ],
      "properties": {
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "e_move"],
          "properties": {
            "metric": { "const": "e_move" },
            "e_move": { "const": 69 }
          }
        },
        "draws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lines", "circles", "duplicate_object_status"],
          "properties": {
            "lines": { "const": 65 },
            "circles": { "const": 4 },
            "duplicate_object_status": { "const": "not_checked" }
          }
        },
        "target_witnesses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pointPair" }
        },
        "first_bound_target_e_move": { "const": 69 },
        "automatic_closure_first_hit": { "const": "not_checked" },
        "claim": { "const": "verified_construction" }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer"],
      "properties": {
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "build_69e_certificate.py" },
            "version": { "const": "1" }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction_sha256"],
      "properties": {
        "construction_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "through"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "line" },
        "through": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/id" },
            { "$ref": "#/$defs/id" }
          ],
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "circleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "center", "through"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "circle" },
        "center": { "$ref": "#/$defs/id" },
        "through": { "$ref": "#/$defs/id" }
      }
    },
    "intersectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "objects", "index"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "intersect" },
        "objects": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/id" },
            { "$ref": "#/$defs/id" }
          ],
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "pointPair": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/id" },
        { "$ref": "#/$defs/id" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    }
  }
}

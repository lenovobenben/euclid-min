{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/regular-257/profile.schema.json",
  "title": "Euclid-Min regular-257 free-edge profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "problem",
    "initial_objects",
    "tools",
    "operations",
    "points",
    "intersections",
    "metric",
    "target",
    "canonicalization"
  ],
  "properties": {
    "schema": { "const": "euclid-min-regular-257-profile/v1" },
    "id": { "const": "regular-257-free-edge-e-fixed-v1" },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "polygon_sides", "semantics"],
      "properties": {
        "id": { "const": "regular-257-free-edge" },
        "type": { "const": "regular_polygon_free_edge" },
        "polygon_sides": { "const": 257 },
        "semantics": { "const": "fixed_instance" }
      }
    },
    "initial_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "circles", "cost"],
      "properties": {
        "points": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/centerPoint" },
            { "$ref": "#/$defs/startPoint" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "circles": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/initialCircle" }],
          "minItems": 1,
          "maxItems": 1
        },
        "cost": { "const": "free" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["straightedge", "collapsing_compass", "non_collapsing_compass"],
      "properties": {
        "straightedge": { "const": true },
        "collapsing_compass": { "const": true },
        "non_collapsing_compass": { "const": false }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "circle_center_through", "duplicate_objects"],
      "properties": {
        "line": { "$ref": "#/$defs/enabledOperation" },
        "circle_center_through": { "$ref": "#/$defs/enabledOperation" },
        "duplicate_objects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["legal", "charged", "add_intersections"],
          "properties": {
            "legal": { "const": true },
            "charged": { "const": true },
            "add_intersections": { "const": false }
          }
        }
      }
    },
    "points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "arbitrary_points", "half_generic_points"],
      "properties": {
        "source": { "const": "initial_or_intersection_only" },
        "arbitrary_points": { "const": false },
        "half_generic_points": { "const": false }
      }
    },
    "intersections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "domain",
        "point_identity",
        "ordering",
        "index_base",
        "coincident_objects"
      ],
      "properties": {
        "generation": { "const": "automatic_new_object_closure" },
        "domain": { "const": "finite_real" },
        "point_identity": { "const": "exact_coordinates" },
        "ordering": { "const": "lexicographic_xy_ascending" },
        "index_base": { "const": 0 },
        "coincident_objects": { "const": "no_isolated_intersections" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "line_cost", "circle_cost", "intersection_binding_cost"],
      "properties": {
        "primary": { "const": "e_move" },
        "line_cost": { "const": 1 },
        "circle_cost": { "const": 1 },
        "intersection_binding_cost": { "const": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "center",
        "circle",
        "polygon_sides",
        "orientation",
        "witness",
        "equality"
      ],
      "properties": {
        "type": { "const": "any_adjacent_pair" },
        "center": { "const": "C" },
        "circle": { "const": "c0" },
        "polygon_sides": { "const": 257 },
        "orientation": { "const": "either" },
        "witness": { "const": "point_pair_in_state" },
        "equality": { "const": "exact_chord_squared" }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serialization", "encoding", "digest"],
      "properties": {
        "serialization": { "const": "rfc8785_jcs" },
        "encoding": { "const": "utf-8" },
        "digest": { "const": "sha256" }
      }
    }
  },
  "$defs": {
    "centerPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinates"],
      "properties": {
        "id": { "const": "C" },
        "coordinates": {
          "type": "array",
          "prefixItems": [{ "const": 0 }, { "const": -1 }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "startPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinates"],
      "properties": {
        "id": { "const": "B" },
        "coordinates": {
          "type": "array",
          "prefixItems": [{ "const": 0 }, { "const": 1 }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "initialCircle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "center", "through"],
      "properties": {
        "id": { "const": "c0" },
        "center": { "const": "C" },
        "through": { "const": "B" }
      }
    },
    "enabledOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requires_distinct_points"],
      "properties": {
        "enabled": { "const": true },
        "requires_distinct_points": { "const": true }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/schemas/suffix-search-summary-v1.schema.json",
  "title": "Euclid-Min Heuristic Suffix Search Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "environment",
    "profile",
    "prefix_last_id",
    "prefix_program_entries",
    "prefix_e_move",
    "max_total_score",
    "suffix_budget",
    "beam_width",
    "candidate_width",
    "workers",
    "state_timeout_seconds",
    "max_input_level",
    "candidate_strategy",
    "max_states",
    "heuristic",
    "status",
    "found_score",
    "stats",
    "interpretation_boundary"
  ],
  "properties": {
    "schema": { "const": "euclid-min-suffix-search-summary/v1" },
    "mode": { "const": "heuristic_nonproof" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sage_version",
        "python_version",
        "platform",
        "cpu_count",
        "docker_image"
      ],
      "properties": {
        "sage_version": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "cpu_count": { "$ref": "#/$defs/positiveInteger" },
        "docker_image": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "regular-17-e-fixed-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "prefix_last_id": { "type": "string", "minLength": 1 },
    "prefix_program_entries": { "$ref": "#/$defs/nonnegativeInteger" },
    "prefix_e_move": { "$ref": "#/$defs/nonnegativeInteger" },
    "max_total_score": { "$ref": "#/$defs/nonnegativeInteger" },
    "suffix_budget": { "$ref": "#/$defs/nonnegativeInteger" },
    "beam_width": { "$ref": "#/$defs/positiveInteger" },
    "candidate_width": { "$ref": "#/$defs/positiveInteger" },
    "workers": { "$ref": "#/$defs/positiveInteger" },
    "state_timeout_seconds": { "$ref": "#/$defs/positiveNumber" },
    "max_input_level": {
      "oneOf": [
        { "$ref": "#/$defs/nonnegativeInteger" },
        { "type": "null" }
      ]
    },
    "candidate_strategy": { "enum": ["diverse", "target-only"] },
    "max_states": {
      "oneOf": [
        { "$ref": "#/$defs/positiveInteger" },
        { "type": "null" }
      ]
    },
    "heuristic": { "enum": ["one-move", "regular"] },
    "status": { "enum": ["found", "state_limit", "heuristic_limit"] },
    "found_score": {
      "oneOf": [
        { "$ref": "#/$defs/nonnegativeInteger" },
        { "type": "null" }
      ]
    },
    "candidate_path": { "type": "string", "minLength": 1 },
    "independent_verifier_valid": { "type": "boolean" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expanded_states",
        "generated_candidates",
        "accepted_states",
        "equivalent_pruned",
        "max_frontier",
        "heuristic_evaluations",
        "heuristic_pruned",
        "elapsed_seconds",
        "candidate_generation_seconds",
        "state_expansion_seconds",
        "state_index_seconds",
        "goal_test_seconds",
        "heuristic_seconds",
        "candidate_prefilter_evaluations",
        "candidate_prefilter_pruned",
        "candidate_prefilter_seconds",
        "candidate_timeouts"
      ],
      "properties": {
        "expanded_states": { "$ref": "#/$defs/nonnegativeInteger" },
        "generated_candidates": { "$ref": "#/$defs/nonnegativeInteger" },
        "accepted_states": { "$ref": "#/$defs/nonnegativeInteger" },
        "equivalent_pruned": { "$ref": "#/$defs/nonnegativeInteger" },
        "max_frontier": { "$ref": "#/$defs/nonnegativeInteger" },
        "heuristic_evaluations": { "$ref": "#/$defs/nonnegativeInteger" },
        "heuristic_pruned": { "$ref": "#/$defs/nonnegativeInteger" },
        "elapsed_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "candidate_generation_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "state_expansion_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "state_index_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "goal_test_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "heuristic_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "candidate_prefilter_evaluations": { "$ref": "#/$defs/nonnegativeInteger" },
        "candidate_prefilter_pruned": { "$ref": "#/$defs/nonnegativeInteger" },
        "candidate_prefilter_seconds": { "$ref": "#/$defs/nonnegativeNumber" },
        "candidate_timeouts": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "interpretation_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegativeNumber": { "type": "number", "minimum": 0 },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 }
  }
}

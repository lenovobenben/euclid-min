{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/schemas/fixed-prefix-two-step-search-v2.schema.json",
  "title": "Euclid-Min exact fixed-prefix two-step search v2",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "source",
    "scope",
    "progress",
    "coverage",
    "result",
    "checkpoint",
    "environment",
    "elapsed_seconds_this_invocation",
    "interpretation"
  ],
  "properties": {
    "schema": {"const": "euclid-min-fixed-prefix-two-step-search/v2"},
    "mode": {"enum": ["exact_partial", "exact_fixed_prefix_exhaustive"]},
    "source": {
      "type": "object",
      "required": ["input_sha256", "legacy_imports"],
      "properties": {
        "input_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "legacy_imports": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "prefix_e_move",
        "extension_budget_e",
        "prefix_points",
        "prefix_lines",
        "prefix_circles",
        "precursor_candidates",
        "terminal_restriction"
      ],
      "properties": {
        "prefix_e_move": {"type": "integer", "minimum": 0},
        "extension_budget_e": {"type": "integer", "minimum": 1},
        "prefix_points": {"type": "integer", "minimum": 2},
        "prefix_lines": {"type": "integer", "minimum": 0},
        "prefix_circles": {"type": "integer", "minimum": 1},
        "precursor_candidates": {"type": "integer", "minimum": 1},
        "terminal_restriction": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "status",
        "scan_complete",
        "exhausted",
        "completed_precursor_candidates",
        "remaining_precursor_candidates",
        "durable_events",
        "checkpoint_granularity"
      ],
      "properties": {
        "status": {
          "enum": [
            "running",
            "paused",
            "found",
            "scan_complete_with_deferred",
            "completed"
          ]
        },
        "scan_complete": {"type": "boolean"},
        "exhausted": {"type": "boolean"},
        "completed_precursor_candidates": {"type": "integer", "minimum": 0},
        "remaining_precursor_candidates": {"type": "integer", "minimum": 0},
        "durable_events": {"type": "integer", "minimum": 0},
        "checkpoint_granularity": {"const": "one_precursor_candidate"}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "precursor_lines",
        "precursor_circles",
        "new_points_total",
        "terminal_parameterizations",
        "terminal_candidates",
        "deferred_relations",
        "structural_existing_objects"
      ],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "result": {
      "type": "object",
      "required": ["successful_branches", "first_hit", "unresolved_relations"],
      "properties": {
        "successful_branches": {"type": "integer", "minimum": 0},
        "first_hit": {"type": ["object", "null"]},
        "unresolved_relations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema", "task_signature", "last_event_sha256", "status"],
      "properties": {
        "schema": {"const": "euclid-min-durable-search-journal/v1"},
        "task_signature": {"$ref": "#/$defs/sha256"},
        "last_event_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["sage_version"],
      "properties": {"sage_version": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "elapsed_seconds_this_invocation": {"type": "number", "minimum": 0},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/schemas/certificate-v1.schema.json",
  "title": "Euclid-Min Construction Certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem",
    "profile",
    "construction",
    "assertions",
    "software",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "euclid-min-certificate/v1" },
    "problem": { "const": "regular-17-adjacent-vertex" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "const": "regular-17-e-fixed-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "program": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/lineEntry" },
              { "$ref": "#/$defs/circleEntry" },
              { "$ref": "#/$defs/intersectEntry" }
            ]
          }
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "targets", "claim"],
      "properties": {
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "e_move"],
          "properties": {
            "metric": { "const": "e_move" },
            "e_move": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["B_plus", "B_minus"]
          }
        },
        "claim": {
          "enum": [
            "verified_construction",
            "shorter_than_verified_baseline",
            "shortest_known_reviewed_literature",
            "globally_minimal"
          ]
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer"],
      "properties": {
        "producer": { "$ref": "#/$defs/softwareIdentity" },
        "solver": { "$ref": "#/$defs/softwareIdentity" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction_sha256"],
      "properties": {
        "construction_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "through"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "line" },
        "through": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "circleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "center", "through"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "circle" },
        "center": { "$ref": "#/$defs/id" },
        "through": { "$ref": "#/$defs/id" }
      }
    },
    "intersectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "objects", "index"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": { "const": "intersect" },
        "objects": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "softwareIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}

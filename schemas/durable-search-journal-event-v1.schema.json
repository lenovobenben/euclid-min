{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/schemas/durable-search-journal-event-v1.schema.json",
  "title": "Euclid-Min durable search journal line v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "type", "task"],
      "properties": {
        "schema": {"const": "euclid-min-durable-search-journal/v1"},
        "type": {"const": "header"},
        "task": {
          "type": "object",
          "required": ["id", "input_sha256", "configuration", "work_ids", "signature"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "input_sha256": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            },
            "configuration": {"type": "object"},
            "work_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "signature": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["sequence", "previous_sha256", "type", "payload", "sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "previous_sha256": {"$ref": "#/$defs/sha256"},
        "type": {"enum": ["legacy_import", "result", "status"]},
        "payload": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

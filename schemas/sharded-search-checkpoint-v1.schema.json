{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://euclid-min.local/schemas/sharded-search-checkpoint-v1.schema.json",
  "title": "Euclid-Min sharded search checkpoint v1",
  "type": "object",
  "required": ["schema", "task", "progress"],
  "properties": {
    "schema": {"const": "euclid-min-sharded-search-checkpoint/v1"},
    "task": {
      "type": "object",
      "required": [
        "id",
        "profile",
        "input_sha256",
        "configuration",
        "shard_ids",
        "signature"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "profile": {
          "type": "object",
          "required": ["id", "sha256"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "input_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "configuration": {"type": "object"},
        "shard_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "signature": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["status", "revision", "completed_shards"],
      "properties": {
        "status": {"enum": ["running", "paused", "completed"]},
        "revision": {"type": "integer", "minimum": 0},
        "completed_shards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "result"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "result": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
